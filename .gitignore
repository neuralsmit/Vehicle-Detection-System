# Byte-compiled / Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/

# Large Model Weights (YOLO weights are auto-downloaded on first run)
*.pt

# Video files (exceed GitHub's 100MB file limit)
*.mp4
*.avi
*.mov
*.mkv
input_videos/*
outputs/*
!input_videos/.gitkeep
!outputs/.gitkeep
!sample_videos/
!sample_videos/demo_sample.mp4

# IDE and System files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
